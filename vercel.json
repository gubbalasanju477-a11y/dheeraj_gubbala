{
  "services": {
    "frontend": {
      "framework": "nextjs",
      "path": "frontend"
    },
    "backend": {
      "framework": "express",
      "path": "backend"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/backend/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/frontend/$1"
    }
  ]
}

